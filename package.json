{
  "name": "@nubisco/cms-core",
  "version": "1.0.0",
  "description": "Framework-agnostic core for the Nubisco CMS: the content contract, field resolution, and the link, image and richtext models. Framework bindings (cms-vue, and later cms-react) build on this.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/cms-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/check-no-framework.mjs && tsc -p tsconfig.json && node scripts/check-esm.mjs",
    "check:core": "node scripts/check-no-framework.mjs",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "check:esm": "node scripts/check-esm.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.3"
  },
  "homepage": "https://github.com/nubisco/cms-core#readme",
  "bugs": {
    "url": "https://github.com/nubisco/cms-core/issues"
  },
  "author": "José Silva <jose@nubisco.io>",
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
